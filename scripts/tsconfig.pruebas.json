{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "../.pruebas-build",
    "rootDir": "..",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "../lib/game/**/*.ts",
    "../lib/three/encuadre.ts",
    "../lib/three/escena.ts",
    "../lib/auth/whatsapp.ts",
    "../lib/auth/datos.ts",
    "../lib/referrals/constants.ts",
    "../lib/wallet/limiteRetiros.ts",
    "../lib/payments/constants.ts",
    "../lib/supabase/env.ts",
    "../types/**/*.ts"
  ],
  "exclude": ["../lib/game/demo.ts"]
}
