# ── Supabase ────────────────────────────────────────────────────────────────
# Sin estas variables la app ARRANCA IGUAL y el juego corre en modo demo
# (partida local, sin dinero). Con ellas hay cuentas, tickets y billetera.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SECRET_KEY=tu-service-role-key     # solo servidor: salta RLS

# ── Validación automática de pagos ──────────────────────────────────────────
# Sin TODAS estas, cada compra queda esperando aprobación a mano. Eso funciona
# —es como arrancó el juego hermano— pero alguien tiene que mirar el banco.
BANK_API_URL=https://...
BANK_API_TOKEN=...
BANK_API_ACCOUNT_NAME=cartones-bdv-1

# ⚠️ LAS DOS MÁS IMPORTANTES DE ESTE ARCHIVO.
#
# La Bank API es MULTICUENTA y La Llave Correcta ya la usa. Reclamar un
# movimiento lo marca como usado y se lo queda quien llegue primero: si estas
# dos apuntaran a la cuenta de La Llave, un pago hecho allí se lo quedaría
# Mis Cartones y aquel jugador se quedaría sin sus tickets.
#
# Tienen que ser la etiqueta y el número de cuenta PROPIOS de este juego. Si
# faltan, la validación automática no se enciende (fallo seguro).
BANK_ACCOUNT_NAME_ESPERADO=cartones-bdv-1
BANK_CUENTA_ESPERADA=0102***0000

# ── Lectura del comprobante (OCR) ───────────────────────────────────────────
# Sin esto NO se puede registrar una compra: la referencia sale del
# comprobante, no del formulario, porque un dato escrito por el navegador no
# sirve para reclamar dinero en el banco.
PAYMENT_OCR_URL=https://...
PAYMENT_OCR_API_KEY=...
# Nuestro nombre tal como lo escribe el banco en el recibo. Sirve para
# DESCARTARLO: lo que se guarda del comprobante es de dónde vino el pago,
# nunca a dónde fue.
PAYMENT_DESTINATION_NOMBRE=

# ── Conciliación periódica ──────────────────────────────────────────────────
CRON_SECRET=

# Poner en 'false' apaga la regla de origen (cada jugador paga siempre desde
# la misma cuenta). Encendida es lo que cierra la puerta a las triangulaciones.
# ORIGIN_RULE_ENABLED=true
